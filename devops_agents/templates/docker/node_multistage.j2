# --- Stage 1: Builder ---
FROM node:{{ version }}-alpine AS builder
WORKDIR /app
# Copy only package files first to leverage Docker cache
COPY package*.json ./
# Install ALL dependencies (including dev) for building
RUN {{ package_manager }} install

COPY . .
# Build the app (if a build script exists)
{% if has_build_script %}
RUN {{ package_manager }} run build
{% endif %}

# --- Stage 2: Runner ---
FROM node:{{ version }}-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy built artifacts from builder
COPY --from=builder /app/package*.json ./
# Install only production dependencies
RUN {{ package_manager }} install --production

# Copy necessary files (dist for TS, or src for JS)
COPY --from=builder /app ./ 

# Inject discovered Environment Variables
{% for key, value in env_vars.items() %}
ENV {{ key }}={{ value }}
{% endfor %}

EXPOSE {{ port }}
CMD ["{{ package_manager }}", "run", "start"]