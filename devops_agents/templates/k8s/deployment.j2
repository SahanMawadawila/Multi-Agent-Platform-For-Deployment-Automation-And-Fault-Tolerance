apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_name }}
  namespace: {{ namespace }}
spec:
  replicas: {{ replicas }}
  selector:
    matchLabels:
      app: {{ app_name }}
  template:
    metadata:
      labels:
        app: {{ app_name }}
    spec:
      imagePullSecrets:
      - name: {{ image_pull_secret }}
      containers:
      - name: {{ app_name }}
        image: {{ image_url }}
        ports:
        - containerPort: {{ port }}
        livenessProbe:
          httpGet:
            path: {{ health_check_path }}
            port: {{ port }}
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: {{ health_check_path }}
            port: {{ port }}
          initialDelaySeconds: 10
          periodSeconds: 5
        resources:
          limits:
            memory: "{{ memory_limit }}"
            cpu: "{{ cpu_limit }}"