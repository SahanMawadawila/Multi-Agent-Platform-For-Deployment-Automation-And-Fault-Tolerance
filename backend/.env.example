DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/Flow_Pilot_AI
JWT_SECRET_KEY=<your_jwt_secret_here>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=6000

GITHUB_CLIENT_ID=<your_github_client_id_here>
GITHUB_SECRET=<your_github_secret_here>

#github config
GITHUB_TOKEN= <your_github_token_here>
GITHUB_ORG=Flow-Pilot-AI

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_AGENT_JOBS=agent-jobs
KAFKA_TERMINAL_TOPIC=project-terminal-events

#security
SECRET_KEY=<your_secret_key_here>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
APP_NAME=Flow Pilot AI
DEBUG=True
FRONTEND_URL=http://localhost:3000

# Webhook Configuration (for auto-sync from original repo to mirror)
# Use ngrok URL for local development: e.g., https://abc123.ngrok-free.app
WEBHOOK_BASE_URL=
# Secret for signing webhook payloads (generate a random string)
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret-here
